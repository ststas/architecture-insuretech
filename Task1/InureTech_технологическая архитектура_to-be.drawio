elBackgroundColor=#ffffff;fontFamily=Arial;fontSize=18;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ng2" target="db1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="994" y="1020"/><mxPoint x="502" y="1020"/></Array></mxGeometry></mxCell><mxCell id="e_ng3_db" value="TCP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=18;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ng3" target="db1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1578" y="1040"/><mxPoint x="594" y="1040"/></Array></mxGeometry></mxCell><mxCell id="e_sync" value="синхронно" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=18;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="db1" target="db2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_async" value="асинхронно" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=18;fontColor=#000000;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="db1" target="db3"><mxGeometry x="-0.5" relative="1" as="geometry"><Array as="points"><mxPoint x="594" y="1190"/><mxPoint x="1693" y="1190"/></Array></mxGeometry></mxCell><mxCell id="e_backup" value="бэкапы + WAL (PITR)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=18;fontColor=#000000;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="db1" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="hc_alb_ng1" value="health check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=18;fontColor=#000000;exitX=0.2818287037037037;exitY=1;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#2e9e5b;fontColor=#2e9e5b;" edge="1" parent="1" source="alb" target="ng1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="hc_probe_u1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=18;fontColor=#000000;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#2e9e5b;fontColor=#2e9e5b;" edge="1" parent="1" source="probe1" target="pods_user1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="hc_probe_p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=18;fontColor=#000000;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#2e9e5b;fontColor=#2e9e5b;" edge="1" parent="1" source="probe1" target="pods_partner1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="hc_alb_ng2" value="health check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=18;fontColor=#000000;exitX=0.6197916666666666;exitY=1;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#2e9e5b;fontColor=#2e9e5b;" edge="1" parent="1" source="alb" target="ng2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="hc_probe_u2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=18;fontColor=#000000;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#2e9e5b;fontColor=#2e9e5b;" edge="1" parent="1" source="probe2" target="pods_user2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="hc_probe_p2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=18;fontColor=#000000;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#2e9e5b;fontColor=#2e9e5b;" edge="1" parent="1" source="probe2" target="pods_partner2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="hc_alb_ng3" value="health check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=18;fontColor=#000000;exitX=0.9577546296296297;exitY=1;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#2e9e5b;fontColor=#2e9e5b;" edge="1" parent="1" source="alb" target="ng3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="hc_probe_u3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=18;fontColor=#000000;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#2e9e5b;fontColor=#2e9e5b;" edge="1" parent="1" source="probe3" target="pods_user3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="hc_probe_p3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=18;fontColor=#000000;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#2e9e5b;fontColor=#2e9e5b;" edge="1" parent="1" source="probe3" target="pods_partner3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="hc_db2" value="health check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=18;fontColor=#000000;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;dashed=1;strokeColor=#2e9e5b;fontColor=#2e9e5b;" edge="1" parent="1" source="db2" target="db1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="hc_db3" value="health check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Arial;fontSize=18;fontColor=#000000;exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;dashed=1;strokeColor=#2e9e5b;fontColor=#2e9e5b;" edge="1" parent="1" source="db3" target="db1"><mxGeometry x="0.5" relative="1" as="geometry"><Array as="points"><mxPoint x="1785" y="1210"/><mxPoint x="525" y="1210"/></Array></mxGeometry></mxCell><mxCell id="note1" value="1. Масштабирование: горизонтальное для приложений (реплики во всех трёх зонах, HPA, Cluster Autoscaler), вертикальное только для БД. Горизонтальное эффективнее: нет потолка одной ВМ, нет простоя при росте, переживается падение узла. Трёх зон достаточно для 99,9 %, дополнительные зоны не нужны." style="shape=stencil(vVNBDsIgEHwNRwxCjHqu+g9iaUtEaBa09fdSwdpi9dBDb8vOwOwsGcQyW/FaIEqsA3MRjcxdhdgBUSp1JUA6XyF2RCwrDIgSzE3n4VzzjtlVV3PvXmjDPdLdoOQRTrvtavNqnAKXw9mDELkBIhDJaxrJZIy/YRLfbjFvpcVgHHfS6JGu4lAK7GVwoXg5gmwjRP3VjoMpqQcm9tPKs0z0Y6crWcBHqt0PN8tJspXFfmNKdpaBH8tYwML/VPjiE6dCKhXSOMTT+PlWiC47PgE=);fillColor=#fff2bf;gradientColor=none;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1988" y="200" width="460" height="156" as="geometry"/></mxCell><mxCell id="note2" value="2. Kubernetes: три независимых зональных кластера, а не один растянутый. Ошибка деплоя, обновления или конфигурации затрагивает один кластер, а не все зоны; обновления катим по очереди. Мощность та же (зона ≤ 50 %), каждый кластер содержит все сервисы, трафик между сервисами остаётся в зоне. Конфигурацию синхронизирует GitOps. Общая только БД с собственным failover." style="shape=stencil(vVNBDsIgEHwNRwxCjHqu+g9iaUtEaBa09fdSwdpi9dBDb8vOwOwsGcQyW/FaIEqsA3MRjcxdhdgBUSp1JUA6XyF2RCwrDIgSzE3n4VzzjtlVV3PvXmjDPdLdoOQRTrvtavNqnAKXw9mDELkBIhDJaxrJZIy/YRLfbjFvpcVgHHfS6JGu4lAK7GVwoXg5gmwjRP3VjoMpqQcm9tPKs0z0Y6crWcBHqt0PN8tJspXFfmNKdpaBH8tYwML/VPjiE6dCKhXSOMTT+PlWiC47PgE=);fillColor=#fff2bf;gradientColor=none;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1988" y="370" width="460" height="198" as="geometry"/></mxCell><mxCell id="note3" value="3. Балансировка и фейловер на уровне клиента: клиент ходит на один адрес. ALB работает во всех трёх зонах и по health check (HTTP /health) убирает неисправную зону; нагрузку принимают две оставшиеся. Зона загружена не больше ≈ 50 %, поэтому две зоны держат 100 % трафика." style="shape=stencil(vVNBDsIgEHwNRwxCjHqu+g9iaUtEaBa09fdSwdpi9dBDb8vOwOwsGcQyW/FaIEqsA3MRjcxdhdgBUSp1JUA6XyF2RCwrDIgSzE3n4VzzjtlVV3PvXmjDPdLdoOQRTrvtavNqnAKXw9mDELkBIhDJaxrJZIy/YRLfbjFvpcVgHHfS6JGu4lAK7GVwoXg5gmwjRP3VjoMpqQcm9tPKs0z0Y6crWcBHqt0PN8tJspXFfmNKdpaBH8tYwML/VPjiE6dCKhXSOMTT+PlWiC47PgE=);fillColor=#fff2bf;gradientColor=none;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1988" y="582" width="460" height="156" as="geometry"/></mxCell><mxCell id="note4" value="4. Bulkhead: партнёрский трафик идёт на отдельный набор подов в отдельной группе узлов, ALB различает его по пути или хосту. Партнёр не отнимает ресурсы у пользователей; сверх 20 RPS его режет API Gateway." style="shape=stencil(vVNBDsIgEHwNRwxCjHqu+g9iaUtEaBa09fdSwdpi9dBDb8vOwOwsGcQyW/FaIEqsA3MRjcxdhdgBUSp1JUA6XyF2RCwrDIgSzE3n4VzzjtlVV3PvXmjDPdLdoOQRTrvtavNqnAKXw9mDELkBIhDJaxrJZIy/YRLfbjFvpcVgHHfS6JGu4lAK7GVwoXg5gmwjRP3VjoMpqQcm9tPKs0z0Y6crWcBHqt0PN8tJspXFfmNKdpaBH8tYwML/VPjiE6dCKhXSOMTT+PlWiC47PgE=);fillColor=#fff2bf;gradientColor=none;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1988" y="752" width="460" height="135" as="geometry"/></mxCell><mxCell id="note5" value="5. БД: Managed PostgreSQL (Patroni). Мастер в зоне 1, синхронная реплика в зоне 2 (RPO ≈ 0 при потере зоны), асинхронная в зоне 3, автоматический failover за минуты. Бэкапы и WAL-архив в Object Storage, PITR: RPO ≤ 15 мин, восстановление укладывается в RTO 45 мин." style="shape=stencil(vVNBDsIgEHwNRwxCjHqu+g9iaUtEaBa09fdSwdpi9dBDb8vOwOwsGcQyW/FaIEqsA3MRjcxdhdgBUSp1JUA6XyF2RCwrDIgSzE3n4VzzjtlVV3PvXmjDPdLdoOQRTrvtavNqnAKXw9mDELkBIhDJaxrJZIy/YRLfbjFvpcVgHHfS6JGu4lAK7GVwoXg5gmwjRP3VjoMpqQcm9tPKs0z0Y6crWcBHqt0PN8tJspXFfmNKdpaBH8tYwML/VPjiE6dCKhXSOMTT+PlWiC47PgE=);fillColor=#fff2bf;gradientColor=none;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1988" y="901" width="460" height="156" as="geometry"/></mxCell><mxCell id="note6" value="6. Шардирование не применяем: данных мало, запись десятки RPS, нужны единая согласованная точка восстановления и простая процедура переключения. Пересмотр: рост размера БД, упор в запись на мастер, рост RPS на порядок." style="shape=stencil(vVNBDsIgEHwNRwxCjHqu+g9iaUtEaBa09fdSwdpi9dBDb8vOwOwsGcQyW/FaIEqsA3MRjcxdhdgBUSp1JUA6XyF2RCwrDIgSzE3n4VzzjtlVV3PvXmjDPdLdoOQRTrvtavNqnAKXw9mDELkBIhDJaxrJZIy/YRLfbjFvpcVgHHfS6JGu4lAK7GVwoXg5gmwjRP3VjoMpqQcm9tPKs0z0Y6crWcBHqt0PN8tJspXFfmNKdpaBH8tYwML/VPjiE6dCKhXSOMTT+PlWiC47PgE=);fillColor=#fff2bf;gradientColor=none;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1988" y="1071" width="460" height="135" as="geometry"/></mxCell><mxCell id="note7" value="7. Cloud CDN: статика отдаётся с точек присутствия во всех восьми федеральных округах (27 городов). Динамические запросы идут в ru-central1, для Дальнего Востока задержка выше; снижаем кешированием публичных GET, сокращением числа запросов и HTTP/2." style="shape=stencil(vVNBDsIgEHwNRwxCjHqu+g9iaUtEaBa09fdSwdpi9dBDb8vOwOwsGcQyW/FaIEqsA3MRjcxdhdgBUSp1JUA6XyF2RCwrDIgSzE3n4VzzjtlVV3PvXmjDPdLdoOQRTrvtavNqnAKXw9mDELkBIhDJaxrJZIy/YRLfbjFvpcVgHHfS6JGu4lAK7GVwoXg5gmwjRP3VjoMpqQcm9tPKs0z0Y6crWcBHqt0PN8tJspXFfmNKdpaBH8tYwML/VPjiE6dCKhXSOMTT+PlWiC47PgE=);fillColor=#fff2bf;gradientColor=none;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1988" y="1220" width="460" height="135" as="geometry"/></mxCell><mxCell id="note8" value="8. Принятый риск: отказ всего региона ru-central1 не покрывается. RTO и RPO гарантируются при отказе зоны или компонента; для восстановления остаются резервные копии в Object Storage." style="shape=stencil(vVNBDsIgEHwNRwxCjHqu+g9iaUtEaBa09fdSwdpi9dBDb8vOwOwsGcQyW/FaIEqsA3MRjcxdhdgBUSp1JUA6XyF2RCwrDIgSzE3n4VzzjtlVV3PvXmjDPdLdoOQRTrvtavNqnAKXw9mDELkBIhDJaxrJZIy/YRLfbjFvpcVgHHfS6JGu4lAK7GVwoXg5gmwjRP3VjoMpqQcm9tPKs0z0Y6crWcBHqt0PN8tJspXFfmNKdpaBH8tYwML/VPjiE6dCKhXSOMTT+PlWiC47PgE=);fillColor=#fff2bf;gradientColor=none;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=16;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1988" y="1369" width="460" height="114" as="geometry"/></mxCell><mxCell id="mk1" value="1" style="ellipse;fillColor=#5282ff;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=16;fontFamily=Arial;html=1;aspect=fixed;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1369" y="761" width="28" height="28" as="geometry"/></mxCell><mxCell id="mk2" value="2" style="ellipse;fillColor=#5282ff;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=16;fontFamily=Arial;html=1;aspect=fixed;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="750" y="986" width="28" height="28" as="geometry"/></mxCell><mxCell id="mk3" value="3" style="ellipse;fillColor=#5282ff;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=16;fontFamily=Arial;html=1;aspect=fixed;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1804" y="516" width="28" height="28" as="geometry"/></mxCell><mxCell id="mk4" value="4" style="ellipse;fillColor=#5282ff;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=16;fontFamily=Arial;html=1;aspect=fixed;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1191" y="811" width="28" height="28" as="geometry"/></mxCell><mxCell id="mk5" value="5" style="ellipse;fillColor=#5282ff;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=16;fontFamily=Arial;html=1;aspect=fixed;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="166" y="1046" width="28" height="28" as="geometry"/></mxCell><mxCell id="mk6" value="6" style="ellipse;fillColor=#5282ff;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=16;fontFamily=Arial;html=1;aspect=fixed;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="750" y="1046" width="28" height="28" as="geometry"/></mxCell><mxCell id="mk7" v