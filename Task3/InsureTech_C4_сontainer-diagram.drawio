        <object placeholders="1" c4Type="Relationship" c4Technology="TCP" c4Description="Чтение таблицы outbox&#xa;раз в 1–2 секунды" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;div style=&quot;text-align: center&quot;&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;" id="t3-e6">
          <mxCell edge="1" parent="1" source="t3-outbox-pub" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=2;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" target="uZ0quFO-MIEIE11IO5jD-2">
            <mxGeometry relative="1" width="240" as="geometry">
              <Array as="points">
                <mxPoint x="871" y="-220" />
              </Array>
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="t3-note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;spacing=8;" value="&lt;b&gt;Как читать схему&lt;/b&gt;&lt;br&gt;Серые сплошные стрелки: синхронные REST-вызовы. Оранжевые пунктирные: события через Kafka.&lt;br&gt;&lt;b&gt;Transactional Outbox:&lt;/b&gt; заявка и событие записываются в core-db одной транзакцией, затем Outbox Publisher отправляет событие в Kafka (минимум один раз), а потребители обрабатывают события идемпотентно по id. Повторы и DLQ защищают от потерь, отставание потребителей (consumer lag) отслеживается в мониторинге." vertex="1">
          <mxGeometry height="145" width="450" x="451" y="70" as="geometry" />
        </mxCell>
